global
    log /dev/log local0
    maxconn 2048
    user haproxy
    group haproxy
    daemon

defaults
    mode http
    log global
    option httplog
    option httpchk GET /
    timeout connect 5s
    timeout client 30s
    timeout server 30s

frontend http_in
    bind {{ keepalived_vip }}:80
    default_backend web_servers

# backends generes depuis le groupe web de l'inventaire
backend web_servers
    balance roundrobin
{% for h in groups['web'] | sort %}
    server {{ h }} {{ hostvars[h].dmz_ip }}:80 check
{% endfor %}

# page de stats accessible seulement depuis le management
listen stats
    bind {{ mgmt_ip }}:{{ haproxy_stats_port }}
    stats enable
    stats uri /
    stats refresh 5s
